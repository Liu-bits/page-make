# Page-make 环境变量示例（只放 key 名，真实值放 GitHub Secrets 或 EdgeOne 控制台，绝不提交）
# 参考：.github/workflows/page-make.yaml 顶部注释

# ===== EdgeOne Pages（主线路）=====
EDGEONE_API_TOKEN=

# ===== Cloudflare Pages（备选线路）=====
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=

# ===== Sign in with Apple =====
# iOS App 的 Bundle ID（作为 Apple 客户端校验 aud）
APPLE_CLIENT_ID=

# ===== 第一版占位，暂不启用（签名 / App Store 上传）=====
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
