# Page-make 环境变量示例（只放 key 名，真实值放 GitHub Secrets / 创空间环境变量，绝不提交）

# ===== ModelScope 创空间部署（GitHub Actions）=====
# Variables（仓库设置 → Secrets and variables → Actions → Variables）
MODELSCOPE_SPACE=            # 用户名/空间名，如 liu20/pagemake
# Secrets
MODELSCOPE_TOKEN=            # ModelScope API Token（控制台 → 个人中心 → 访问令牌）

# ===== 运行时（创空间环境变量 / 本地容器）=====
# Sign in with Apple：iOS App 的 Bundle ID（校验 Apple 登录 token 的 aud）
APPLE_CLIENT_ID=
# 数据目录（创空间持久卷默认已设 /mnt/workspace/pagemake-data）
# DATA_DIR=
# 监听端口（ModelScope 约定 7860）
# PORT=

# ===== 仅本地调试（生产环境禁止！等于关闭登录鉴权）=====
# DEV_NO_AUTH=1
